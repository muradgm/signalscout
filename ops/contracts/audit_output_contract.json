{
  "type": "object",
  "required": [
    "summary",
    "issues",
    "evidence_links",
    "impact",
    "recommendations",
    "confidence"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "evidence_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue",
          "evidence",
          "source"
        ],
        "properties": {
          "issue": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "impact": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    }
  }
}
