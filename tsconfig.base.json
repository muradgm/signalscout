{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@signalscout/shared": ["packages/shared/src/index.ts"],
      "@signalscout/logger": ["packages/logger/src/index.ts"],
      "@signalscout/core": ["packages/core/src/index.ts"],
      "@signalscout/db": ["packages/db/src/index.ts"],
      "@signalscout/ai": ["packages/ai/src/index.ts"],
      "@signalscout/scraper": ["packages/scraper/src/index.ts"],
      "@signalscout/email": ["packages/email/src/index.ts"],
      "@signalscout/queue": ["packages/queue/src/index.ts"]
    }
  }
}