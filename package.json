{
  "name": "signalscout",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.6.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "test:p1": "node --test tests/mvp/usecases.test.mjs",
    "ops:doctor": "node scripts/ops/doctor.mjs",
    "ops:gate": "node scripts/ops/gate.mjs",
    "ops:task:init": "node scripts/ops/task-init.mjs",
    "ops:guard": "node scripts/ops/guard.mjs",
    "ops:status": "node scripts/ops/status.mjs",
    "ops:preflight": "node scripts/ops/preflight.mjs",
    "build:p1": "pnpm --filter @signalscout/core build && pnpm --filter @signalscout/ai build && pnpm --filter @signalscout/scraper build && pnpm --filter @signalscout/api build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dashboard": "^0.0.1",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "rimraf": "^6.1.3",
    "turbo": "^2.9.0",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.58.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "fuser": "^2.0.0",
    "helmet": "^8.1.0",
    "mongoose": "^9.3.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vite": "^8.0.3"
  }
}
