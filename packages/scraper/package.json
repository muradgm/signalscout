{
  "name": "@signalscout/scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "pnpm exec tsc -b -w tsconfig.json",
    "build": "pnpm exec tsc -b tsconfig.json",
    "lint": "eslint .",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "test": "node --test ../../tests/mvp/signals.test.mjs ../../tests/mvp/benchmark.test.mjs ../../tests/mvp/provider-extractors.test.mjs",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@signalscout/core": "workspace:*",
    "cheerio": "^1.2.0"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "@types/node": "^22.19.15"
  }
}
