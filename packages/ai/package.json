    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@signalscout/core": "workspace:*",
    "openai": "^4.104.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "rimraf": "^6.0.1"
  }
