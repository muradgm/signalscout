{
  "name": "@signalscout/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "pnpm exec tsc -b -w tsconfig.json",
    "build": "pnpm exec tsc -b tsconfig.json",
    "lint": "eslint .",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "test": "node --test ../../tests/mvp/usecases.test.mjs ../../tests/mvp/benchmark.test.mjs",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.15",
    "rimraf": "^6.0.1"
  }
}
